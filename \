                                idx_queue.push_back(idx_1.left_ptr()
                                    .ok_or(CustomErr::Execution("Must be left ptr".to_string()))?);
                            } else if idx_value_0 < *target && *target < idx_value_1 {
                                idx_queue.push_back(idx_1.left_ptr()
                                    .ok_or(CustomErr::Execution("Must be left ptr".to_string()))?);
