        let page = btree.parse_page(page_ptr)?;
        let page_type = page.page_type();
        let right_ptr = page.right_ptr();

        let target = idx_filter.target();
        // Cells, include page type here
        let cells_offset = page.cells_order();
        
        // Empty cells and having right ptr
        if cells_offset.is_empty() && right_ptr.is_some() {
            idx_queue.push_back(*right_ptr.expect("Must not be None")); 
            continue;
        };

        let extract_idx_payload = |i: usize, page: &Page, cells_offset: &[u64]|
            -> (u64, ValueExpr, ValueExpr)
            {
                // Return row id 0, idx value 0, idx value 1
