                let idx_value_1 = idx_1.indexed_value()
                    .ok_or(CustomErr::Execution("Must be indexed value".to_string()))?;
                (row_id_0, idx_value_0, idx_value_1)
            };
        
        match page_type {
            PageType::IdxInterior => {
                // Evaluate on all cells of a node, to get next node
                match idx_filter.op() {
                    CompSpecOp::Eq => {
                        // Search range [I, I+1)
                        for i in 0..cells_offset.len()-1 {
                            let idx_0 = page.cell(&cells_offset[i])?;
                            let idx_1 = page.cell(&cells_offset[i+1])?;
                            let row_id_0 = idx_0.row_id()
                                .ok_or(CustomErr::Execution("Must be row id".to_string()))?;
                            let row_id_1 = idx_1.row_id()
                                .ok_or(CustomErr::Execution("Must be row id".to_string()))?;
                            let idx_value_0 = idx_0.indexed_value()
                                .ok_or(CustomErr::Execution("Must be indexed value".to_string()))?;
                            let idx_value_1 = idx_1.indexed_value()
                                .ok_or(CustomErr::Execution("Must be indexed value".to_string()))?;

                            if *target < idx_value_0 {
                                continue;
                            } else if idx_value_0 == *target { 
